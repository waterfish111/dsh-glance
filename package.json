{
  "name": "@local/dsh-glance",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "一瞥 / Glance：置顶悬浮球 + 框选任意屏幕区域 + 多模态流式分析。",
  "license": "MIT",
  "author": "water fish",
  "homepage": "https://github.com/waterfish111/dsh-glance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waterfish111/dsh-glance.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "vision",
    "webview2"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node test/stop-cancel.test.mjs && node test/panel-compile.mjs",
    "check": "node --check index.js && node --check client.js && npm test"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "widget.ps1",
    "panel.html",
    "webview2/*.dll",
    "webview2/LICENSE.txt",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
