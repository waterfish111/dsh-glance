{
  "name": "@local/dsh-glance",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "一瞥 / Glance：置顶悬浮球 + 框选任意屏幕区域 + 多模态流式分析。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "widget.ps1",
    "panel.html",
    "webview2/*.dll",
    "webview2/LICENSE.txt",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
